#include <iostream>
using namespace std;

int main() {
    // Завдання Integer13
    int n;
    cout << "Введіть трицифрове число: ";
    cin >> n;

    int first = n / 100;
    int result = (n % 100) * 10 + first;

    cout << "Integer13 — Результат: " << result << endl;

    // Завдання Integer24
    int K;
    cout << "\nВведіть номер дня року (1–365): ";
    cin >> K;

    int day = K % 7;

    cout << "Integer24 — Номер дня тижня: "
         << day << endl;

    // Завдання Integer41
    int M;
    cout << "\nВведіть кількість гривень: ";
    cin >> M;

    int coins = M / 5;
    int remainder = M % 5;

    cout << "Integer41 — Кількість монет по 5 грн: "
         << coins << endl;
    cout << "Integer41 — Решта: "
         << remainder << " грн" << endl;

    return 0;
}
